# Neon connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
PORT=4000
# Comma-separated list of allowed frontends (public app + police portal are the same origin)
CORS_ORIGIN=http://localhost:5173
# Generate with:  openssl rand -hex 32     (REQUIRED, keep secret)
JWT_SECRET=
# Salt for hashing device/session ids (any random string)
PROBE_SALT=change-me-salt
# Vehicles needed on a road before probe speeds change its congestion (use 3+ in production)
PROBE_MIN_VEHICLES=1
# Area to import from OpenStreetMap: south,west,north,east (default = central Kigali)
OSM_BBOX=-2.02,30.00,-1.88,30.16
